# Copy to .env inside /opt/tks-docker (chmod 600 .env) before starting the 3-node + 2-CLI stack.
# Generate strong random secrets with: openssl rand -hex 32

TKS_NODE_VERSION=v0.1.28
CIPHER_CLI_VERSION=v0.2.6

# Require signed TKS-CIPHER-AUTH-V1 wallet proofs on /fetch, /ack, /register, /ws (set 0 only temporarily for old mobile builds)
CIPHER_REQUIRE_CLIENT_SIG=1
CIPHER_RATE_LIMIT_PER_MIN=1200

# Keep 127.0.0.1 for zero 0.0.0.0 host bindings (all client/explorer/relay traffic goes through Nginx -> 127.0.0.1).
# Only set to 0.0.0.0 if external cross-VPS P2P peers must dial :30333 / :4001 directly.
TKS_P2P_BIND_IP=127.0.0.1

# Peer ID of tks-fullnode inside tks-bridge (production chainspec master peer ID)
TKS_FULLNODE_PEER_ID=12D3KooWJdK1KAe1BBjsGjgdc9vSWhibk63B8qXwpPFe5p5Saa88

# Allowed CORS origins for JSON-RPC on tks-fullnode (never use "all")
TKS_RPC_CORS=https://tksscan.com,https://rpc.tokenkickstarter.com,https://tokenkickstarter.com,https://app.tokenkickstarter.com,http://127.0.0.1:8172

# Shared secrets for authenticated Cipher v0.1.27 endpoints
CIPHER_FEDERATED_PUSH_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
CIPHER_SHARD_INGEST_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Encryption passphrases for cipher-cli-1 and cipher-cli-2 identity.json
CIPHER_CLI_1_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_24
CIPHER_CLI_2_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_24

# Transport & polling defaults for Cipher CLI containers
CIPHER_TRANSPORT_MODE=auto
CIPHER_POLL_INTERVAL=5
